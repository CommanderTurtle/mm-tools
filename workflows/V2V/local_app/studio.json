{
  "id": "id-v2v",
  "title": "ID-V2V Film Lab",
  "short_name": "IV",
  "kind": "IDENTITY-PRESERVING VIDEO",
  "port": 8265,
  "kicker": "SHOOT FIRST · RESTYLE LATER · PRIVATE INT8",
  "hero": "Hold the performance. Redesign the world.",
  "description": "A complete local treatment room for identity-preserving video restylization: automatic foreground controls, imperfect keyframes, arbitrary ordered keyframes, overlap-conditioned long clips, exact relighting, the released normal+depth model, and the same flip-test package used to inspect whether a performance survived the edit.",
  "guide": "Choose Restyle for a new world around a performance, Exact relight when only illumination should change, and Normal + depth when you already have geometry controls. Frame zero establishes the look. Extra keyframes are ordered exactly like their 0-based indices and each index must be divisible by four.",
  "engine": "ID-V2V INT8 ConvRot · Comfy PR #15139",
  "vram": "32 GiB · GPU inference",
  "runtime_contract": "RTX 5090 · PR-pinned private Comfy · GPU inference · Comfy-managed weight offload",
  "residency": "One ephemeral loopback Comfy runtime per job",
  "default_mode": "restyle",
  "max_upload_bytes": 34359738368,
  "theme": {"accent": "#a3e6c0", "secondary": "#ad8a6b"},
  "badges": ["Identity + lip-sync", "Imperfect keyframes", "Long-video continuity", "Normal + depth", "Flip test", "No cloud nodes"],
  "groups": [
    {"id": "create", "title": "Create"},
    {"id": "control", "title": "Control laboratory"}
  ],
  "models": [
    {"label": "ID-V2V", "path": "../ComfyUI/models/diffusion_models/wan_2.1_idv2v_int8_convrot.safetensors", "note": "20.2 GB INT8 ConvRot"},
    {"label": "ID-V2V normal + depth", "path": "../ComfyUI/models/diffusion_models/wan_2.1_idv2v_with_normal_depth_int8_convrot.safetensors", "note": "Three-control alternate checkpoint"},
    {"label": "UMT5 XXL", "path": "../ComfyUI/models/text_encoders/umt5_xxl_fp8_e4m3fn_scaled.safetensors", "note": "FP8 scaled"},
