    {"label": "Local subject matte", "path": "../../sculpting/pretrained/deps/ZhengPeng7--BiRefNet", "note": "Shared; no duplicate checkpoint"}
  ],
  "setup_steps": [
    "Run `cd ~/multimedia/workflows/V2V && ./setupwithuv.sh` once. This prepares the single shared ID-V2V / Animate 2 environment.",
    "Run `./startwithuv.sh`; open the printed loopback URL. No Comfy editor or API is exposed to the LAN.",
    "For normal+depth, provide three synchronized control videos: foreground pixels, surface normals, and depth. The two checkpoints are deliberately never interchanged."
  ],
  "presets": [
    {"title": "Cinematic restyle", "mode": "restyle", "controls": {"width": 832, "height": 480, "max_frames": 81, "clip_frames": 81, "steps": 24, "control_strategy": "auto_matte", "pixel_strength": 1, "save_flip_test": true, "save_side_by_side": true}},
    {"title": "Portrait performance", "mode": "restyle", "controls": {"width": 480, "height": 832, "max_frames": 81, "clip_frames": 81, "steps": 24, "control_strategy": "auto_matte", "pixel_strength": 1}},
    {"title": "Long drift-controlled take", "mode": "restyle", "controls": {"width": 832, "height": 480, "max_frames": 240, "clip_frames": 81, "steps": 24, "seed_policy": "increment", "save_verbose": true}},
    {"title": "Lighting only", "mode": "relight", "controls": {"width": 832, "height": 480, "max_frames": 81, "clip_frames": 81, "pixel_strength": 1.1, "steps": 24}},
    {"title": "Geometry locked", "mode": "normal_depth", "controls": {"width": 832, "height": 480, "max_frames": 81, "clip_frames": 81, "pixel_strength": 1, "normal_strength": 0.85, "depth_strength": 0.8, "steps": 26}},
    {"title": "Inspect the matte", "mode": "control_lab", "controls": {"width": 832, "height": 480, "max_frames": 81, "control_strategy": "auto_matte", "matte_threshold": 0.35, "matte_feather": 5, "background_gray": 127}}
  ],
  "modes": [
    {
      "id": "restyle",
      "group": "create",
      "title": "Performance restyle",
      "short": "Carry identity, expression, gaze, and body motion into a newly art-directed scene.",
      "description": "The released single-control ID-V2V route with local foreground-on-gray preparation, direct prepared-control support, imperfect first frames, ordered extra keyframes, and automatic 81-frame overlap continuity for long takes.",
      "icon": "◫",
      "badge": "RECOMMENDED",
      "engine": "ID-V2V INT8",
      "input_label": "Source performance + stylized frame",
      "output_label": "Stitched film + controls + A/B package",
      "recipe": "The style frame need not perfectly align with frame zero. ID-V2V re-aligns from subsequent frames. Add more edited frames for long takes or deliberate art-direction changes.",
      "fields": [
        {"type": "section", "label": "Footage & art direction"},
        {"id": "source_video_asset", "type": "asset", "label": "Source performance", "required": true, "span": "half", "accept": "video/*", "icon": "▶", "drop_label": "Drop the original take", "hint": "Expression, gaze, body movement, and timing come from this clip."},
        {"id": "style_frame_asset", "type": "asset", "label": "Stylized first frame", "required": true, "span": "half", "accept": "image/*", "icon": "◎", "drop_label": "Drop the desired look", "hint": "Imperfect alignment is supported; preserve the subject identity when possible."},
        {"id": "prompt", "type": "textarea", "label": "Scene, lighting, and style direction", "required": true, "default": "cinematic scene, stable identity, faithful expression and eye gaze, coherent detailed background", "rows": 4, "span": "full"},
        {"id": "control_strategy", "type": "choice", "label": "Pixel control", "default": "auto_matte", "span": "full", "options": [
          {"value": "auto_matte", "label": "Automatic foreground on gray", "description": "Private BiRefNet matte; restyle the environment while protecting the performer."},
          {"value": "precomputed", "label": "Prepared control video", "description": "Use an externally inspected SAM3/BiRefNet foreground-on-gray render."},
          {"value": "source", "label": "Raw source pixels", "description": "Preserve the whole shot more strongly; useful for restrained treatments."}
        ]},
        {"id": "pixel_control_asset", "type": "asset", "label": "Prepared pixel control · when selected", "required": false, "span": "full", "accept": "video/*", "icon": "◐", "drop_label": "Drop foreground-on-gray control"},
        {"type": "section", "label": "Timeline & keyframes"},
        {"id": "width", "type": "number", "label": "Width", "min": 256, "max": 1280, "step": 16, "default": 832, "suffix": " px", "span": "third"},
        {"id": "height", "type": "number", "label": "Height", "min": 256, "max": 1280, "step": 16, "default": 480, "suffix": " px", "span": "third"},
        {"id": "fps", "type": "range", "label": "Output FPS", "min": 1, "max": 60, "step": 1, "default": 24, "span": "third"},
        {"id": "max_frames", "type": "number", "label": "Maximum output frames", "min": 1, "max": 10000, "step": 1, "default": 81, "span": "half", "hint": "Long clips are segmented and conditioned on their preceding overlap frame."},
        {"id": "clip_frames", "type": "select", "label": "Frames per diffusion clip", "default": 81, "span": "half", "options": [{"value": 41, "label": "41 · fastest proof"}, {"value": 61, "label": "61 · balanced"}, {"value": 81, "label": "81 · upstream native"}, {"value": 121, "label": "121 · extended"}, {"value": 161, "label": "161 · maximum local"}]},
        {"id": "keyframe_assets", "type": "multi_asset", "label": "Extra stylized keyframes · optional", "required": false, "span": "full", "accept": "image/*", "icon": "◆", "drop_label": "Drop edited frames in chronological order", "hint": "Upload together in the same order as the frame indices below."},
        {"id": "keyframe_indices", "type": "tags", "label": "0-based keyframe indices", "span": "full", "placeholder": "40, then 80, then …", "hint": "One index per image; positive, unique, and divisible by four."},
        {"type": "section", "label": "Identity & generation"},
        {"id": "pixel_strength", "type": "range", "label": "Performance control", "min": 0, "max": 2, "step": 0.01, "default": 1, "span": "half", "hint": "Higher follows source pose and expression more tightly."},
        {"id": "seed", "type": "number", "label": "Seed", "min": 0, "max": 1125899906842624, "step": 1, "default": 42, "span": "half"},
        {"id": "seed_policy", "type": "choice", "label": "Long-take seed policy", "default": "increment", "span": "full", "options": [{"value": "increment", "label": "Increment each clip", "description": "Avoid repeating texture while continuity frames hold the look."}, {"value": "fixed", "label": "Fixed", "description": "Maximum deterministic consistency across clip boundaries."}]}
      ],
      "advanced": [
        {"type": "section", "label": "Automatic matte"},
        {"id": "matte_threshold", "type": "range", "label": "Foreground threshold", "min": 0, "max": 0.9, "step": 0.01, "default": 0.35, "span": "third"},
        {"id": "matte_feather", "type": "range", "label": "Edge feather", "min": 0, "max": 24, "step": 1, "default": 5, "span": "third"},
        {"id": "background_gray", "type": "range", "label": "Control gray", "min": 0, "max": 255, "step": 1, "default": 127, "span": "third"},
        {"type": "section", "label": "Sampler"},
        {"id": "steps", "type": "range", "label": "Sampling steps", "min": 4, "max": 60, "step": 1, "default": 24, "span": "third"},
        {"id": "guidance", "type": "range", "label": "CFG", "min": 0, "max": 8, "step": 0.05, "default": 1, "span": "third"},
        {"id": "shift", "type": "number", "label": "Model shift", "min": 0, "max": 20, "step": 0.1, "default": 5, "span": "third"},
        {"id": "sampler", "type": "select", "label": "Sampler", "default": "er_sde", "span": "third", "options": [{"value": "er_sde", "label": "ER-SDE · reference"}, {"value": "euler", "label": "Euler"}, {"value": "dpmpp_2m", "label": "DPM++ 2M"}]},
        {"id": "scheduler", "type": "select", "label": "Scheduler", "default": "simple", "span": "third", "options": [{"value": "simple", "label": "Simple"}, {"value": "sgm_uniform", "label": "SGM uniform"}, {"value": "normal", "label": "Normal"}]},
        {"id": "denoise", "type": "range", "label": "Denoise", "min": 0.1, "max": 1, "step": 0.01, "default": 1, "span": "third"},
        {"id": "add_noise", "type": "toggle", "label": "Seeded noise", "default": true, "span": "half", "toggle_label": "Initialize latent noise"},
        {"id": "negative_prompt", "type": "textarea", "label": "Negative prompt", "default": "oversaturated, overexposed, static, blurred details, subtitles, watermark, low quality, jpeg artifacts, deformed face, malformed hands, fused fingers, duplicate limbs, identity drift, frozen expression, temporal flicker, abrupt lighting changes, inconsistent background", "rows": 4, "span": "full"},
        {"type": "section", "label": "Framing & evidence package"},
        {"id": "crop", "type": "select", "label": "Resize crop", "default": "center", "span": "half", "options": [{"value": "center", "label": "Center crop"}, {"value": "disabled", "label": "No crop"}]},
        {"id": "scale_method", "type": "select", "label": "Resize filter", "default": "lanczos", "span": "half", "options": [{"value": "lanczos", "label": "Lanczos"}, {"value": "area", "label": "Area"}, {"value": "bicubic", "label": "Bicubic"}, {"value": "bilinear", "label": "Bilinear"}]},
        {"id": "container", "type": "select", "label": "Final container", "default": "mp4", "span": "third", "options": [{"value": "mp4", "label": "MP4"}, {"value": "mkv", "label": "Matroska"}]},
        {"id": "codec", "type": "select", "label": "Final codec", "default": "h264", "span": "third", "options": [{"value": "h264", "label": "H.264"}, {"value": "av1", "label": "AV1"}]},
        {"id": "crf", "type": "range", "label": "Delivery CRF", "min": 0, "max": 51, "step": 1, "default": 18, "span": "third"},
        {"id": "bit_depth", "type": "select", "label": "Working bit depth", "default": 8, "span": "half", "options": [{"value": 8, "label": "8-bit"}, {"value": 10, "label": "10-bit"}]},
        {"id": "color_space", "type": "select", "label": "Working color space", "default": "sRGB", "span": "half", "options": [{"value": "sRGB", "label": "sRGB"}, {"value": "HDR", "label": "BT.2020 HLG"}, {"value": "HDR PQ", "label": "BT.2020 PQ"}]},
        {"id": "save_flip_test", "type": "toggle", "label": "Flip test", "default": true, "span": "third", "toggle_label": "Export generated ↔ source A/B"},
        {"id": "flip_interval", "type": "range", "label": "A/B interval", "min": 0.5, "max": 8, "step": 0.5, "default": 2, "suffix": " s", "span": "third"},
        {"id": "save_side_by_side", "type": "toggle", "label": "Comparison", "default": true, "span": "third", "toggle_label": "Export generated | source"},
        {"id": "save_verbose", "type": "toggle", "label": "Per-clip evidence", "default": true, "span": "full", "toggle_label": "Keep every generated clip and control artifact"}
      ],
      "preview_template": "{{width}}×{{height}} · {{max_frames}} frames · {{control_strategy}} · strength {{pixel_strength}}"
    },
