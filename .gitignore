# Models are always reconstructed locally. These are the only tracked files
# beneath models/.
!/models/
/models/**
!/models/ARCHITECTURE.md
!/models/download_models.py
!/models/download_models_info.txt
!/models/which-ones.txt

# vox/, even-g2-duet/, and .git-archives/ are consequently excluded in full.

# Runtime bytecode is always disposable, including beneath explicitly opened
# vendor-runtime directories.
**/__pycache__/
# MiniMax Music embeds its own tokenizer; the Qwen/Krea2 writing lane uses
# qwen25_tokenizer. Keep shared Python imports, not unrelated vocabularies.
/minimax/runtime/comfy/text_encoders/ace_lyrics_tokenizer/
/minimax/runtime/comfy/text_encoders/byt5_tokenizer/
/minimax/runtime/comfy/text_encoders/hydit_clip_tokenizer/
/minimax/runtime/comfy/text_encoders/llama_tokenizer/
/minimax/runtime/comfy/text_encoders/qwen35_tokenizer/
/minimax/runtime/comfy/text_encoders/t5_pile_tokenizer/
/minimax/runtime/comfy/text_encoders/t5_tokenizer/

# Build metadata and upstream notices must survive the runtime-only export.
!/acestep/LICENSE
!/ideogram/LICENSE.md
!/ideogram/ComfyUI-Ideogram4/
/ideogram/ComfyUI-Ideogram4/*
!/ideogram/ComfyUI-Ideogram4/LICENSE.md
!/ideogram/vendor/
/ideogram/vendor/*
!/ideogram/vendor/ObjectClear/
/ideogram/vendor/ObjectClear/*
!/ideogram/vendor/ObjectClear/LICENSE
!/ideogram/model_licenses/
/ideogram/model_licenses/*
!/ideogram/model_licenses/LICENSE-IDEOGRAM-4-NON-COMMERCIAL
!/longcat/LICENSE
!/muscriptor/LICENSE
!/muscriptor/README.md
!/musvit/vendor/
/musvit/vendor/*
!/musvit/vendor/SMT/
/musvit/vendor/SMT/*
!/musvit/vendor/SMT/LICENSE
!/redesign/LICENSE
!/redesign/modules/
/redesign/modules/*
!/redesign/modules/grounding_dino/
/redesign/modules/grounding_dino/*
!/redesign/modules/grounding_dino/LICENSE
!/redesign/modules/ObjectClear/
/redesign/modules/ObjectClear/*
!/redesign/modules/ObjectClear/LICENSE
!/stableaudio/LICENSE
!/stableaudio/LICENSES/
/stableaudio/LICENSES/*
!/stableaudio/LICENSES/LICENSE_*.txt
!/vocalrender/LICENSE
!/whisper/LICENSE
!/whisper/README.md

**/*.py[cod]

# Private Ideogram editor source only; never its subprocess state or artifacts.
!/ideogram/object_remover/
/ideogram/object_remover/*
!/ideogram/object_remover/*.py
!/ideogram/object_remover/web/
/ideogram/object_remover/web/*
!/ideogram/object_remover/web/*.html
!/ideogram/object_remover/web/*.css
!/ideogram/object_remover/web/*.js
!/ideogram/object_remover/comfy_nodes/
