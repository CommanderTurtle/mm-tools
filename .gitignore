# This monorepo is a deliberately pruned runtime export. The index is the
# allowlist; every untracked production, vendor, model, cache, output, and
# archived-history file is denied by default.
/*

# Root repository files.
!/.gitignore
!/LICENSE
!/README.md

# Runtime projects are already tracked by the root index. Keeping their root
# directories ignored makes every additional production/vendor file opt-in;
# tracked files continue to behave normally.

# Canonical per-project setup and launch entrypoints. Re-open each project
# directory only long enough to allow these files; every other new file stays
# denied by default.
!/ideogram/
/ideogram/*
!/ideogram/setupwithuv
!/ideogram/startwithuv
!/ideogram/start-object-remover.sh

!/img2svg/
/img2svg/*
!/img2svg/setupwithrust
!/img2svg/startwithrust

!/longcat/
/longcat/*
!/longcat/setupwithuv
!/longcat/starthttp.sh
!/longcat/startwithuv.sh

!/muscriptor/
/muscriptor/*
!/muscriptor/setupwithuv
!/muscriptor/startwithuv
!/muscriptor/startwithuv.sh

!/musvit/
/musvit/*
!/musvit/setupwithuv
!/musvit/startwithuv
!/musvit/local_app/
/musvit/local_app/*
!/musvit/local_app/__init__.py
!/musvit/local_app/server.py
!/musvit/local_app/web/
/musvit/local_app/web/*
!/musvit/local_app/web/app.js
!/musvit/local_app/web/index.html
!/musvit/local_app/web/style.css

!/redesign/
/redesign/*
!/redesign/setupwithuv
!/redesign/startwithuv
!/redesign/startwithuv.sh

!/translate/
/translate/*
!/translate/setupwithuv.sh
!/translate/starthttp.sh
!/translate/startwithuv.sh
!/translate/local_app/
/translate/local_app/*
!/translate/local_app/__init__.py
!/translate/local_app/server.py
!/translate/web/
/translate/web/*
!/translate/web/app.js
!/translate/web/index.html
!/translate/web/style.css

!/video-compact/
/video-compact/*
!/video-compact/setupwithuv
!/video-compact/startwithuv
!/video-compact/startwithuv.sh

!/video-to-gif-avif/
/video-to-gif-avif/*
!/video-to-gif-avif/setupwithuv
!/video-to-gif-avif/startwithuv
!/video-to-gif-avif/startwithuv.sh

!/whisper/
/whisper/*
!/whisper/setupwithuv
!/whisper/starthttp.sh
!/whisper/startwithuv.sh

# Models are always reconstructed locally. These are the only tracked files
# beneath models/.
!/models/
/models/**
!/models/download_models.py
!/models/download_models_info.txt
!/models/which-ones.txt

# vox/, even-g2-duet/, and .git-archives/ are consequently excluded in full.
