# This monorepo is a deliberately pruned runtime export. The index is the
# allowlist; every untracked production, vendor, model, cache, output, and
# archived-history file is denied by default.
/*

# Root repository files.
!/README.md
/.mm-tools-expansion-todo.md
!/tests/
/tests/*
!/tests/audit-export.py
!/tests/RUNTIME-EXPORT.md

# Runtime projects are already tracked by the root index. Keeping their root
# directories ignored makes every additional production/vendor file opt-in;
# tracked files continue to behave normally.

# Canonical per-project setup and launch entrypoints. Re-open each project
# directory only long enough to allow these files; every other new file stays
# denied by default.
!/acestep/
/acestep/*
!/acestep/.env.local.example
!/acestep/ARCHITECTURE.md
!/acestep/requirements-local.txt
!/acestep/setupwithuv.sh
!/acestep/startwithuv.sh

!/ideogram/
/ideogram/*
!/ideogram/setupwithuv.sh
!/ideogram/startwithuv.sh
!/ideogram/start-object-remover.sh

!/img2svg/
/img2svg/*
!/img2svg/setupwithrust
!/img2svg/startwithrust

!/longcat/
/longcat/*
!/longcat/setupwithuv.sh
!/longcat/starthttp.sh
!/longcat/startwithuv.sh

