# Project-owned workbench runtimes.
!/**/local_app/runtime.py
!/**/local_app/comfy_runtime.py
!/**/local_app/requirements.txt
!/**/local_app/web/
!/**/local_app/web/**

# vox/, even-g2-duet/, and .git-archives/ are consequently excluded in full.

# Runtime bytecode is always disposable, including beneath explicitly opened
# vendor-runtime directories.
**/__pycache__/
# MiniMax Music embeds its own tokenizer; the Qwen/Krea2 writing lane uses
# qwen25_tokenizer. Keep shared Python imports, not unrelated vocabularies.
/music/minimax/runtime/comfy/text_encoders/ace_lyrics_tokenizer/
/music/minimax/runtime/comfy/text_encoders/byt5_tokenizer/
/music/minimax/runtime/comfy/text_encoders/hydit_clip_tokenizer/
/music/minimax/runtime/comfy/text_encoders/llama_tokenizer/
/music/minimax/runtime/comfy/text_encoders/qwen35_tokenizer/
/music/minimax/runtime/comfy/text_encoders/t5_pile_tokenizer/
/music/minimax/runtime/comfy/text_encoders/t5_tokenizer/

