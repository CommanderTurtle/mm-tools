IDEOGRAM4_QUANTIZATION=fp8
IDEOGRAM4_FP8_MODEL=${HOME}/multimedia/models/ideogram-ai--ideogram-4-fp8
IDEOGRAM4_REPO=${HOME}/multimedia/ideogram

# Private OpenAI-compatible VLM used only to turn plain language into Ideogram JSON.
IDEOGRAM_LOCAL_BASE_URL=http://127.0.0.1:8000/v1
IDEOGRAM_LOCAL_MODEL=
IDEOGRAM_LOCAL_TIMEOUT=240
IDEOGRAM_LOCAL_TEMPERATURE=0.2

PYTHON_VERSION=3.12
UV_TORCH_BACKEND=cu130
OBJECT_REMOVER_HOST=0.0.0.0
OBJECT_REMOVER_PORT=8174
OBJECT_REMOVER_MAX_UPLOAD_MB=128
OBJECT_REMOVER_DEVICE=auto
OBJECT_REMOVER_CPU_OFFLOAD=0
OBJECTCLEAR_SOURCE=${HOME}/multimedia/ideogram/vendor/ObjectClear
OBJECTCLEAR_MODEL=${HOME}/multimedia/models/jixin0101--ObjectClear
OBJECTCLEAR_AGF=1
BIREFNET_MODEL=${HOME}/multimedia/models/ZhengPeng7--BiRefNet
COMFYUI_PORT=8188
# Private masked-edit lane. No external Comfy server is used.
# The monorepo's bundled runtime/interpreter is reused, NOT its music server.
IDEOGRAM_PRIVATE_PORT=8175
IDEOGRAM_COMFY_RUNTIME=${HOME}/multimedia/minimax/runtime
IDEOGRAM_COMFY_PYTHON=${HOME}/multimedia/minimax/.venv/bin/python
IDEOGRAM_CAPTION_MODEL=${HOME}/multimedia/models/qwen/text-encoder-vl-nvfp4/qwen3_vl_4b_nvfp4_full.safetensors
IDEOGRAM_EDIT_TIMEOUT=1800

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
TOKENIZERS_PARALLELISM=false
GRADIO_ANALYTICS_ENABLED=false
