# MuScriptor uses the already-downloaded checkpoint. Keep model files outside
# this repository so rebuilding the environment never duplicates 5+ GB.
MUSCRIPTOR_MODEL_PATH=/home/alienl/multimedia/models/MuScriptor--muscriptor-large/model.safetensors
MUSCRIPTOR_SF2_PATH=/home/alienl/multimedia/models/MuScriptor--assets/MuseScore_General.sf2
MUSCRIPTOR_SF3_PATH=/home/alienl/multimedia/models/MuScriptor--assets/MuseScore_General.sf3

# Independent UV environment. cu130 is appropriate for the RTX 5090 host.
PYTHON_VERSION=3.13.12
UV_TORCH_BACKEND=cu130
MUSCRIPTOR_DEVICE=cuda
# Leave blank to retain MuScriptor's CUDA default: fp32 weights with fp16
# autocast during transformer compute. Valid overrides: float32/float16/bfloat16.
MUSCRIPTOR_DTYPE=

MUSCRIPTOR_HOST=0.0.0.0
MUSCRIPTOR_PORT=8222

# No network lookup or analytics is needed at runtime.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
