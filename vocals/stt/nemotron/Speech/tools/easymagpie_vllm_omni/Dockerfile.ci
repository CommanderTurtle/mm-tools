FROM vllm/vllm-openai:v0.24.0

COPY tools/easymagpie_vllm_omni/requirements.txt /tmp/easymagpie-requirements.txt

RUN python3 -m pip install --no-cache-dir \
    -r /tmp/easymagpie-requirements.txt \
    coverage \
    pytest \
    pytest-asyncio \
    "setuptools>=64"

WORKDIR /workspace

ENTRYPOINT []
