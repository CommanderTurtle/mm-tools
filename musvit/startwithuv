#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

[[ -x .venv/bin/python ]] || {
  printf 'Missing .venv. Run ./setupwithuv first.\n' >&2
  exit 1
}

if [[ -f .env ]]; then
  set -a
  # shellcheck disable=SC1091
  source .env
  set +a
fi
# shellcheck disable=SC1091
source .venv/bin/activate

if [[ $# -gt 0 ]]; then
  exec uv run --active --no-sync python sheet_to_midi.py "$@"
fi

exec uv run --active --no-sync python -m uvicorn local_app.server:app \
  --host "${MUSVIT_HOST:-0.0.0.0}" \
  --port "${MUSVIT_PORT:-8223}"
