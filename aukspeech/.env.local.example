# Optional, local-only Prompt Enhancer. The structured AuK studio works without
# this file. Public endpoints are refused by the adapter.
LLM_API_KEY=local
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL_NAME=your-local-instruct-model

# Set to 1 only when the LLM endpoint is on a trusted RFC1918/ZeroTier/LAN host.
AUK_ALLOW_PRIVATE_LAN_LLM=0

# Listener defaults remain loopback-only.
AUK_STUDIO_HOST=127.0.0.1
AUK_STUDIO_PORT=8260
# MM_STUDIO_TOKEN=choose-a-long-token-before-binding-to-a-private-LAN-interface
