# Existing local Hugging Face-format checkpoint. No model is downloaded by setup.
CW2_MODEL_PATH=/home/alienl/multimedia/models/nyralabs--CrisperWhisper2.0_large

# transformers uses the existing checkpoint directly and avoids a second CT2 copy.
# Use ct2 only after explicitly installing the upstream ct2 extra and converting a model.
CW2_BACKEND=transformers
CW2_DEVICE=cuda
CW2_COMPUTE_TYPE=float16
CW2_DRAFT_MODEL=
CW2_CACHE_DIR=/home/alienl/.cache/crisperwhisper

# RTX 5090 workstation default. Portable alternatives include auto, cpu, and rocm7.1.
PYTHON_VERSION=3.12
UV_TORCH_BACKEND=cu130

CW2_HOST=0.0.0.0
CW2_PORT=8172
CW2_AUTOLOAD=1
CW2_MAX_UPLOAD_MB=1024
# Browsers permit microphone capture on localhost or HTTPS secure contexts.
# Set both paths for microphone capture from another LAN device.
CW2_TLS_CERTFILE=
CW2_TLS_KEYFILE=

# Keep inference and dependency behavior local and quiet.
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
TOKENIZERS_PARALLELISM=false
