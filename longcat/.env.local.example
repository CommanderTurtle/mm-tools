# Checkpoints stay outside the source tree. ./setupwithuv.sh links the shared
# model store into ./models, and both paths below are inferred from that link, so
# nothing here has to name the repository (multimedia, mm-tools, anything else).
# Uncomment only to override the inference; relative values resolve against this
# folder, so the launcher's working directory never matters.
# LONGCAT_MODELS_DIR=../models
# LONGCAT_MODEL_PATH=models/meituan-longcat--AudioDiT-3.5B-tts-text-to-speech-SOTA
# LONGCAT_TOKENIZER_PATH=models/google--umt5-base-tokenizer

PYTHON_VERSION=3.13.12
UV_TORCH_BACKEND=cu130
LONGCAT_DEVICE=cuda
LONGCAT_DTYPE=bfloat16

LONGCAT_HOST=0.0.0.0
LONGCAT_PORT=8230
LONGCAT_UI_PORT=8231
LONGCAT_AUTOLOAD=1
LONGCAT_MAX_UPLOAD_MB=128
LONGCAT_ROUTER_URL=http://127.0.0.1:8182

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
TOKENIZERS_PARALLELISM=false

