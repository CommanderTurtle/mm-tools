# Existing, SHA-verified 3.5B checkpoint. The model stays outside the source
# tree and is never copied into the UV environment.
LONGCAT_MODEL_PATH=/home/alienl/multimedia/models/meituan-longcat--AudioDiT-3.5B-tts-text-to-speech-SOTA
LONGCAT_TOKENIZER_PATH=/home/alienl/multimedia/models/google--umt5-base-tokenizer

PYTHON_VERSION=3.13.12
UV_TORCH_BACKEND=cu130
LONGCAT_DEVICE=cuda
# bfloat16 is the 32 GB RTX 5090 workstation default. The WAV-VAE is always
# converted to fp16, matching the authors' reference inference.
LONGCAT_DTYPE=bfloat16

LONGCAT_HOST=0.0.0.0
# Stable machine-client API used by Vox.
LONGCAT_PORT=8230
# Separate ephemeral browser workbench; starts without loading weights.
LONGCAT_UI_PORT=8231
LONGCAT_AUTOLOAD=1
LONGCAT_MAX_UPLOAD_MB=128
# Browser-side Hoist target. With the UI open in Windows, loopback reaches
# the native Vox router without sending generated audio over the LAN.
LONGCAT_ROUTER_URL=http://127.0.0.1:8182

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
TOKENIZERS_PARALLELISM=false
