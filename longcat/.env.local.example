# Existing checkpoint and tokenizer remain outside the source tree.
LONGCAT_MODEL_PATH=${HOME}/multimedia/models/meituan-longcat--AudioDiT-3.5B-tts-text-to-speech-SOTA
LONGCAT_TOKENIZER_PATH=${HOME}/multimedia/models/google--umt5-base-tokenizer

PYTHON_VERSION=3.13.12
UV_TORCH_BACKEND=cu130
LONGCAT_DEVICE=cuda
LONGCAT_DTYPE=bfloat16

LONGCAT_HOST=0.0.0.0
LONGCAT_PORT=8230
LONGCAT_UI_PORT=8231
LONGCAT_AUTOLOAD=1
LONGCAT_MAX_UPLOAD_MB=128
LONGCAT_ROUTER_URL=http://127.0.0.1:8182

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
TOKENIZERS_PARALLELISM=false

