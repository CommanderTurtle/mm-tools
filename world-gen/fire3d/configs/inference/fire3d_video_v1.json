{
  "schema": "ff_unified_pipeline_protocol_v1",
  "name": "fire3d_video_v1",
  "version": 1,
  "status": "release",
  "created_at": "2026-09-07T00:37:42-05:00",
  "updated_at": "2026-09-07T14:00:00-05:00",
  "description": "Fire3D v1 release protocol for iTHOR and Imaginarium inference.",
  "scope": {
    "datasets": ["ithor", "imaginarium"],
    "scene_manifests": {
      "ithor": "benchmarks/scene_reconstruction/manifests/ithor_v1.json",
      "imaginarium": "benchmarks/scene_reconstruction/manifests/imaginarium_v1.json"
    },
    "coordinate_contract": "dataset_world_without_posthoc_alignment"
  },
  "lineage": {
    "behavior_source": "inference_sep6_v4_bg_roomfit_video",
    "behavior_source_version": 1,
    "behavior_source_sha256": "0d5108eb7ccb91d2eb4054bedaeb71858d190f4ab9d9836d121bb14f9229695d",
    "validated_git_commit": "44233d13bba7d03a7ec3f9ad9817abe283e7f85d",
    "validation_record": "design/20260906_video_roomfit_parallel_inference_profile.md",
    "semantic_contract": "All inference_sep6_v4 output-affecting model, conditioning, background, topology, texture, evaluation, camera, and rendering settings are preserved. Execution changes are independently explicit SS/Shape and PBR flow batches of 16, Shape/PBR VAE decode chunks of 16, no persisted raw ovoxel NPZ intermediates, CuMesh/xatlas batches and CPU workers up to 32, and power-of-two sparse texture-query padding. Exact-vs-power2 fixed-UV texture arrays were byte-identical; larger flow batches were rejected after a geometry-quality regression."
  },
  "reference": {
    "ithor_validation_scene": "iTHOR_FloorPlan312_physics",
    "imaginarium_validation_scene": "bedroom_01",
    "note": "The release protocol is shared by iTHOR and Imaginarium."
  },
  "input_rgb": {
    "mode": "canonical_exact_camera_preferred",
    "fallback_mode": "run_local_exact_camera_rerender",
    "disable_global_exact_rgb_resolver": false,
    "source_fire3d_test_root": "data",
    "overlay_relative_root": "source/dataset",
    "renderer": "blender_4_5_1_eevee_next",
    "recipe": "canonical_pbr",
    "samples": 32,
    "jpeg_quality": 95,
    "expected_frames": 60,
    "expected_width": 512,
    "expected_height": 512
  },
  "perception": {
    "bundle": "checkpoints/Fire3D/perception",
    "checkpoint": "model.pt",
    "dino_repo": "third_party/dinov3",
    "dino_model": "checkpoints/Fire3D/external/dinov3_vitl16_pretrain_lvd1689m-8aa4cbdd.pth",
    "valid_score_threshold": 0.2,
    "nms_iou_threshold": 0.4,
    "clean_instance_labels_by_obbs": false,
    "feature_extraction": {
      "dino_patch_stride": 16,
      "dino_upsample": 1,
      "anyup_frame_batch_size": 1,
      "rgb_upsample": 1,
      "rgb_upsampler": "swin2sr",
      "feature_subsample": 1,
      "effective_point_stride": 16
    },
    "model_contract": {
      "scene_normalization": "point_normalize_xyz_min_translation_only",
      "position_token_range": [0.0, 24.0],
      "position_bins": 1024,
      "detector_queries": 384,
      "voxel_resolution": 256,
      "background_is_predicted_instance": true,
      "rotation_equivalence": "local_up_quarter_turn_yaw"
    },
    "required_outputs": [
      "oriented_bboxes.json",
      "raw_oriented_bboxes.json",
      "point_instance_masks.pkl",
      "det_seg_metrics.json"
    ]
  },
  "reconstruction": {
    "bundle": "checkpoints/Fire3D/reconstruction",
    "decoders": {
      "shape": "checkpoints/Fire3D/external/trellis2/shape_dec_next_dc_f16c32_fp16",
      "pbr": "checkpoints/Fire3D/external/trellis2/tex_dec_next_dc_f16c32_fp16"
    },
    "flow": {
      "ss": {
        "model_family": "ss_x2_offline",
        "checkpoint": "flows/ss/model.pt",
        "use_ema": false
      },
      "shape": {
        "model_family": "shape_x2_offline",
        "checkpoint": "flows/shape/model.pt",
        "use_ema": false
      },
      "pbr": {
        "model_family": "pbr_x2_offline",
        "checkpoint": "flows/pbr/model.pt",
        "use_ema": false
      },
      "inference_num_steps": 12,
      "pbr_guidance_strength": 3.0,
      "seed": 20260717,
      "max_cond_len": 1024,
      "pbr_max_cond_len": 1024,
      "sample_method": "fps",
      "pbr_sample_method": "fps",
      "object_batch_size": 16,
      "ss_shape_object_batch_size": 16,
      "pbr_object_batch_size": 16
    },
    "vae": {
      "ss": {
        "root": "vae/ss",
        "checkpoint": "decoder.pt",
        "use_ema": true
      },
      "shape": {
        "root": "vae/shape",
        "checkpoint": "decoder.pt",
        "use_ema": true
      },
      "pbr": {
        "root": "vae/pbr",
        "checkpoint": "decoder.pt",
        "use_ema": false
      }
    },
    "conditioning": {
      "dino_upsample": 4,
      "anyup_frame_batch_size": 16,
      "perception_label_transfer": "voxel_transfer",
      "perception_voxel_resolution": 256,
      "perception_scene_scale": 24.0,
      "pbr_condition_snap": false
    },
    "occupancy": {
      "threshold": 0.5,
      "empty_policy": "argmax"
    },
    "background": {
      "room_box_prior": true,
      "unit_box_prune": true,
      "canonical_transform": "room_box_isotropic_enclose",
      "canonical_margin": 0.01,
      "distance": 0.12,
      "adaptive_max_distance": 0.25,
      "trim_quantile": 0.01,
      "yaw_samples": 180,
      "min_points": 512,
      "prune_oversized_instances": true,
      "oversized_instance_volume_ratio": 1.0
    },
    "geometry_stage": {
      "mesh_decode": false,
      "mesh_decode_batch_size": 16,
      "shape_decode_resolution": 512,
      "shape_mesh_decimation_target": 100000,
      "shape_mesh_remesh": true,
      "shape_mesh_remesh_band": 1.0,
      "shape_mesh_remesh_project": 0.0,
      "export_world_object_meshes": true,
      "historical_inconsistency": "Resolved in this protocol: geometry-stage decoding is skipped, and geometry evaluation consumes the final appearance-stage topology backfilled into the evaluator PLY contract."
    },
    "appearance_decode": {
      "object_chunk_size": 16,
      "persist_raw_decoded": false
    },
    "mesh_postprocess": {
      "backend": "batch",
      "object_batch_size": 8,
      "uv_cpu_workers": 32,
      "texture_size": 512,
      "decimation_target": 100000,
      "background_decimation_multiplier": 1.0,
      "topology_remesh": true,
      "topology_remesh_band": 1.0,
      "topology_remesh_project": 0.0,
      "topology_initial_target_multiplier": 3,
      "topology_simplify_threshold": 1e-8,
      "topology_chart_area_penalty": 0.1,
      "surface_mapping": "source_bvh",
      "sparse_query_mode": "power2",
      "texture_fill_mode": "telea",
      "texture_dilation_pixels": 4,
      "texture_dilation_pixels_effective": false,
      "texture_erode_iterations": 2,
      "texture_erode_iterations_effective": false,
      "xatlas_block_align": false,
      "projection_raster_instance_batch_size": 8
    },
    "execution": {
      "resume_existing": true,
      "continue_on_error": true,
      "model_cache": false,
      "read_workers": 8,
      "detailed_profile": false,
      "raw_output_layout": "reconstruction/<scene_id>"
    }
  },
  "evaluation": {
    "enabled": false,
    "reason": "The release inference example does not require ground-truth meshes.",
    "point_downsample": 8,
    "sample_points": 100000
  },
  "views": {
    "profile": "source_coverage_diversity",
    "num_views": 16,
    "lookat_distance": 2.0,
    "width": 960,
    "height": 540,
    "intrinsics": {
      "source": "dataset_camera",
      "retargeting": "vertical_fov_preserved",
      "square_pixels": true,
      "principal_point": "viewport_center"
    },
    "validated_reference": {
      "dataset": "ithor",
      "scene_id": "iTHOR_FloorPlan312_physics",
      "source_frame_indices": [58, 0, 6, 36, 50, 59, 2, 52, 1, 3, 7, 57, 4, 51, 5, 38],
      "output_intrinsics": {
        "fx": 465.92230833810555,
        "fy": 465.92230833810555,
        "cx": 480.0,
        "cy": 270.0
      }
    }
  },
  "render": {
    "engine": "blender_4_5_1_eevee_next",
    "recipe": "canonical_pbr",
    "style": "normal",
    "samples": 32,
    "empty_background_rgb": [255, 255, 255],
    "two_sided": true,
    "opaque_material_fix": true,
    "geometry_palette": "legacy",
    "gt_background": true,
    "reconstruction_geometry_background": false,
    "reconstruction_texture_background": true,
    "comparison_columns": [
      "gt_texture",
      "reconstruction_geometry",
      "reconstruction_texture"
    ],
    "comparison_rows": 16,
    "comparison_width": 2880,
    "comparison_height": 8640
  }
}
