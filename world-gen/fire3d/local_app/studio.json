{
  "id": "fire3d",
  "title": "Fire3D Scene Foundry",
  "short_name": "FIRE",
  "kind": "VISIBLE-SCENE RECONSTRUCTION",
  "port": 8268,
  "kicker": "RGB · ORGANIZED GEOMETRY · OBJECTS · PBR WORLD",
  "hero": "Recover an editable, textured world from one observed view.",
  "description": "Prepare Fire3D's real organized RGB/point-cloud contract, reconstruct every visible object, inspect the composed GLB in-browser, and preserve the exact protocol and input bundle. The native perception, SS, Shape-X2, PBR-X2, TRELLIS.2, and CuMesh stages stay local.",
  "guide": "If you already have metric depth, begin with RGB + metric depth to create a reusable Fire3D bundle. Reconstruction is intentionally staged: perception, geometry, and appearance never cache together, and flow weights use BF16 residency with object batches of one.",
  "engine": "Fire3D release + TRELLIS.2 PBR reconstruction",
  "vram": "RTX 5090 32 GB staged profile",
  "runtime_contract": "CUDA-only model residency · BF16 flows · no telemetry · no CPU offload",
  "residency": "One native subprocess per job; models released between native stages",
  "default_mode": "reconstruct_files",
  "max_upload_bytes": 34359738368,
  "theme": {"accent": "#ff765c", "secondary": "#f2c66d"},
  "badges": ["Truthful organized point-cloud input", "Batch-one 5090 protocol", "PBR GLB composition", "Native WebGL inspection", "Reusable input bundles", "Exact run receipts"],
  "groups": [
    {"id": "create", "title": "Reconstruct"},
    {"id": "prepare", "title": "Prepare inputs"},
    {"id": "inspect", "title": "Inspect"}
  ],
  "models": [
    {"label": "Fire3D perception + three reconstruction flows", "path": "checkpoints/Fire3D/"},
    {"label": "DINOv3 source pinned by setup", "path": "third_party/dinov3/"},
    {"label": "Native TRELLIS.2 decoders", "path": "checkpoints/Fire3D/external/trellis2/"}
  ],
  "setup_steps": [
    "Run `cd ~/multimedia/world-gen/fire3d && ./setupwithuv.sh` once. It uses Python 3.10, the CUDA 13.0 PyTorch index (compatible with the CUDA 13.3 host), and exact native extension revisions.",
    "Inputs are not invented from RGB alone: provide aligned H/2×W/2 geometry, a prepared ZIP, or metric depth plus camera intrinsics.",
    "Start with `./startwithuv.sh`. The listener is loopback-only and the browser GLB viewer needs no Blender or cloud renderer."
  ],
  "presets": [
    {"title": "5090 quality reconstruction", "mode": "reconstruct_files", "controls": {"inference_steps": 12, "texture_size": 512, "decimation_target": 100000, "pbr_guidance": 3, "uv_workers": 4, "render_views": false}},
    {"title": "Fast proof", "mode": "reconstruct_bundle", "controls": {"inference_steps": 8, "texture_size": 256, "decimation_target": 60000, "pbr_guidance": 3, "uv_workers": 2, "render_views": false}},
    {"title": "Prepare millimetre depth", "mode": "prepare_rgbd", "controls": {"depth_scale": 0.001, "minimum_depth": 0.05, "maximum_depth": 30}},
    {"title": "Inspect an existing world", "mode": "inspect_glb", "controls": {}}
  ],
  "modes": [
    {
      "id": "reconstruct_files",
      "group": "create",
      "title": "RGB + aligned point cloud → world",
      "short": "Run the full release pipeline from Fire3D's native single-image contract.",
      "description": "The PLY must be organized in image order with exactly (H/2)×(W/2) vertices. A camera file is optional for browser-only GLB output and required only for native Blender view rendering.",
      "icon": "◫",
      "badge": "FULL PIPELINE",
      "engine": "Perception → SS → Shape-X2 → PBR-X2 → GLB",
      "input_label": "RGB + aligned_pcd.ply",
      "output_label": "Textured world GLB + objects + reports",
      "recipe": "The studio validates the organized lattice before CUDA, writes a native dataset, and records the modified batch-one release protocol.",
      "fields": [
        {"type": "section", "label": "Native single-image input"},
        {"id": "rgb_asset", "type": "asset", "label": "RGB observation", "required": true, "span": "half", "accept": "image/png,image/jpeg,image/webp", "icon": "◉", "drop_label": "Drop the exact observed RGB frame"},
        {"id": "pointcloud_asset", "type": "asset", "label": "Organized aligned point cloud", "required": true, "span": "half", "accept": ".ply", "icon": "⌁", "drop_label": "Drop aligned_pcd.ply", "hint": "Exactly H/2×W/2 vertices in image order; invalid pixels may be NaN."},
        {"id": "camera_asset", "type": "asset", "label": "Native camera.json", "required": false, "span": "half", "accept": ".json", "icon": "⌾", "drop_label": "Optional Fire3D camera contract"},
        {"id": "scene_id", "type": "text", "label": "Scene ID", "default": "local-scene", "span": "half"},
        {"type": "section", "label": "Camera fallback"},
        {"id": "focal_x", "type": "number", "label": "Focal X", "min": 1, "step": 0.1, "default": 1200, "span": "quarter"},
        {"id": "focal_y", "type": "number", "label": "Focal Y", "min": 1, "step": 0.1, "default": 1200, "span": "quarter"},
        {"id": "principal_x", "type": "number", "label": "Principal X", "min": 0, "step": 0.1, "default": 512, "span": "quarter"},
        {"id": "principal_y", "type": "number", "label": "Principal Y", "min": 0, "step": 0.1, "default": 512, "span": "quarter"},
        {"type": "section", "label": "Reconstruction quality"},
        {"id": "inference_steps", "type": "range", "label": "Flow steps", "min": 4, "max": 24, "step": 1, "default": 12, "span": "third"},
        {"id": "pbr_guidance", "type": "range", "label": "PBR guidance", "min": 0, "max": 8, "step": 0.1, "default": 3, "span": "third"},
        {"id": "seed", "type": "number", "label": "Seed", "min": 0, "max": 4294967295, "default": 20260717, "span": "third"},
        {"id": "max_condition_points", "type": "select", "label": "SS/Shape condition points", "default": 1024, "span": "third", "options": [{"value": 512, "label": "512 · lean"}, {"value": 1024, "label": "1024 · release"}]},
        {"id": "pbr_condition_points", "type": "select", "label": "PBR condition points", "default": 512, "span": "third", "options": [{"value": 256, "label": "256 · lean"}, {"value": 512, "label": "512 · release"}]},
        {"id": "texture_size", "type": "select", "label": "Texture atlas", "default": 512, "span": "third", "options": [{"value": 256, "label": "256 · proof"}, {"value": 512, "label": "512 · release"}, {"value": 1024, "label": "1024 · high detail"}]},
        {"id": "decimation_target", "type": "number", "label": "Triangles per object", "min": 10000, "max": 500000, "step": 5000, "default": 100000, "span": "third"},
        {"id": "uv_workers", "type": "number", "label": "UV CPU workers", "min": 1, "max": 16, "step": 1, "default": 4, "span": "third"},
        {"id": "read_workers", "type": "number", "label": "Input workers", "min": 1, "max": 8, "step": 1, "default": 2, "span": "third"},
        {"id": "wall_alignment", "type": "toggle", "label": "Room wall canonicalization", "default": false, "span": "third", "toggle_label": "Estimate a 90° room yaw before normalization"},
        {"id": "skip_existing", "type": "toggle", "label": "Resume completed native stages", "default": true, "span": "third", "toggle_label": "Reuse valid per-scene outputs"},
        {"id": "detailed_profile", "type": "toggle", "label": "Detailed native timing", "default": true, "span": "third", "toggle_label": "Write stage-level performance evidence"},
        {"id": "render_views", "type": "toggle", "label": "Native Blender proof sheet", "default": false, "span": "third", "toggle_label": "Render the input camera after GLB creation", "hint": "Optional. The built-in GLB viewer works without Blender."}
      ],
      "advanced": [],
      "preview_template": "{{inference_steps}} flow steps · {{texture_size}}px PBR · scene {{scene_id}}"
    },
    {
      "id": "reconstruct_bundle",
      "group": "create",
      "title": "Prepared bundle → world",
      "short": "Reuse a validated input bundle without rebuilding geometry.",
      "description": "Accepts a ZIP containing one RGB image, aligned_pcd.ply, and optional camera.json. Nested folders are accepted after safe extraction; ambiguous duplicates and traversal paths are rejected.",
      "icon": "⇥",
      "badge": "REUSABLE INPUT",
      "engine": "Fire3D staged 5090 profile",
      "input_label": "Fire3D input ZIP",
      "output_label": "PBR world + native reports",
      "fields": [
        {"id": "bundle_asset", "type": "asset", "label": "Prepared input bundle", "required": true, "span": "full", "accept": ".zip", "icon": "⇥", "drop_label": "Drop fire3d-input.zip"},
        {"id": "scene_id", "type": "text", "label": "Scene ID", "default": "local-scene", "span": "third"},
        {"id": "inference_steps", "type": "range", "label": "Flow steps", "min": 4, "max": 24, "step": 1, "default": 12, "span": "third"},
        {"id": "seed", "type": "number", "label": "Seed", "min": 0, "max": 4294967295, "default": 20260717, "span": "third"},
        {"id": "pbr_guidance", "type": "range", "label": "PBR guidance", "min": 0, "max": 8, "step": 0.1, "default": 3, "span": "third"},
        {"id": "max_condition_points", "type": "select", "label": "SS/Shape condition points", "default": 1024, "span": "third", "options": [{"value": 512, "label": "512"}, {"value": 1024, "label": "1024"}]},
        {"id": "pbr_condition_points", "type": "select", "label": "PBR condition points", "default": 512, "span": "third", "options": [{"value": 256, "label": "256"}, {"value": 512, "label": "512"}]},
        {"id": "texture_size", "type": "select", "label": "Texture atlas", "default": 512, "span": "third", "options": [{"value": 256, "label": "256"}, {"value": 512, "label": "512"}, {"value": 1024, "label": "1024"}]},
        {"id": "decimation_target", "type": "number", "label": "Triangles per object", "min": 10000, "max": 500000, "step": 5000, "default": 100000, "span": "third"},
        {"id": "uv_workers", "type": "number", "label": "UV workers", "min": 1, "max": 16, "default": 4, "span": "third"},
        {"id": "read_workers", "type": "number", "label": "Input workers", "min": 1, "max": 8, "default": 2, "span": "third"},
        {"id": "wall_alignment", "type": "toggle", "label": "Room wall canonicalization", "default": false, "span": "third", "toggle_label": "Estimate a room yaw"},
        {"id": "skip_existing", "type": "toggle", "label": "Resume native stages", "default": true, "span": "third", "toggle_label": "Reuse valid outputs"},
        {"id": "detailed_profile", "type": "toggle", "label": "Detailed timings", "default": true, "span": "third", "toggle_label": "Write performance evidence"},
        {"id": "render_views", "type": "toggle", "label": "Blender proof sheet", "default": false, "span": "third", "toggle_label": "Render after reconstruction"}
      ],
      "advanced": []
    },
    {
      "id": "reconstruct_release",
      "group": "create",
      "title": "Local release dataset → world",
      "short": "Run any locally installed Fire3D release layout by scene ID.",
      "description": "For the official single-image, ScanNet++, iTHOR, and Imaginarium layouts. Nothing is downloaded and the selected root is never uploaded or exposed.",
      "icon": "▦",
      "badge": "DURABLE DATASET",
      "engine": "Fire3D release CLI",
      "input_label": "Private local dataset path",
      "output_label": "Scene reconstruction library entry",
      "fields": [
        {"id": "dataset", "type": "choice", "label": "Dataset contract", "default": "single_image", "span": "full", "options": [{"value": "single_image", "label": "Single image"}, {"value": "scannetpp", "label": "ScanNet++"}, {"value": "ithor", "label": "iTHOR"}, {"value": "imaginarium", "label": "Imaginarium"}]},
        {"id": "data_root", "type": "text", "label": "Fire3D data root", "default": "~/multimedia/world-gen/fire3d/data", "required": true, "span": "half"},
        {"id": "scene_id", "type": "text", "label": "Scene ID (blank uses release example)", "default": "", "span": "half"},
        {"id": "inference_steps", "type": "range", "label": "Flow steps", "min": 4, "max": 24, "step": 1, "default": 12, "span": "third"},
        {"id": "pbr_guidance", "type": "range", "label": "PBR guidance", "min": 0, "max": 8, "step": 0.1, "default": 3, "span": "third"},
        {"id": "seed", "type": "number", "label": "Seed", "default": 20260717, "span": "third"},
        {"id": "max_condition_points", "type": "select", "label": "SS/Shape condition points", "default": 1024, "span": "third", "options": [{"value": 512, "label": "512"}, {"value": 1024, "label": "1024"}]},
        {"id": "pbr_condition_points", "type": "select", "label": "PBR condition points", "default": 512, "span": "third", "options": [{"value": 256, "label": "256"}, {"value": 512, "label": "512"}]},
        {"id": "texture_size", "type": "select", "label": "Texture atlas", "default": 512, "span": "third", "options": [{"value": 256, "label": "256"}, {"value": 512, "label": "512"}, {"value": 1024, "label": "1024"}]},
        {"id": "decimation_target", "type": "number", "label": "Triangles per object", "default": 100000, "span": "third"},
        {"id": "uv_workers", "type": "number", "label": "UV workers", "default": 4, "span": "third"},
        {"id": "read_workers", "type": "number", "label": "Input workers", "default": 2, "span": "third"},
        {"id": "wall_alignment", "type": "toggle", "label": "Room wall canonicalization", "default": false, "span": "third", "toggle_label": "Estimate a room yaw"},
        {"id": "skip_existing", "type": "toggle", "label": "Resume native stages", "default": true, "span": "third", "toggle_label": "Reuse valid outputs"},
        {"id": "detailed_profile", "type": "toggle", "label": "Detailed timings", "default": true, "span": "third", "toggle_label": "Write performance evidence"},
        {"id": "render_views", "type": "toggle", "label": "Blender proof sheet", "default": false, "span": "third", "toggle_label": "Render after reconstruction"}
      ],
      "advanced": []
    },
    {
      "id": "prepare_rgbd",
      "group": "prepare",
      "title": "RGB + metric depth → Fire3D input",
      "short": "Project calibrated metric depth into the exact organized PLY contract.",
      "description": "This model-free tool preserves every H/2×W/2 lattice position, writes invalid samples as NaN, creates camera.json, validates the result, and packages a reusable ZIP.",
      "icon": "⌁",
      "badge": "NO MODEL LOAD",
      "engine": "Calibrated pinhole projection",
      "input_label": "RGB + depth + intrinsics",
      "output_label": "ZIP + PLY + camera + receipt",
      "fields": [
        {"id": "rgb_asset", "type": "asset", "label": "RGB observation", "required": true, "span": "half", "accept": "image/*", "icon": "◉", "drop_label": "Drop RGB image"},
        {"id": "depth_asset", "type": "asset", "label": "Metric depth", "required": true, "span": "half", "accept": ".npy,.png,.tif,.tiff", "icon": "⌁", "drop_label": "Drop 2-D depth array or image"},
        {"id": "scene_id", "type": "text", "label": "Scene ID", "default": "local-scene", "span": "third"},
        {"id": "depth_scale", "type": "number", "label": "Stored units → metres", "min": 0.000001, "max": 10, "step": 0.000001, "default": 0.001, "span": "third", "hint": "Use 0.001 for millimetre PNGs; often 1 for metre NPY arrays."},
        {"id": "minimum_depth", "type": "number", "label": "Near clip", "min": 0, "max": 10, "step": 0.01, "default": 0.05, "span": "third", "suffix": " m"},
        {"id": "maximum_depth", "type": "number", "label": "Far clip", "min": 0.1, "max": 1000, "step": 0.1, "default": 100, "span": "third", "suffix": " m"},
        {"id": "focal_x", "type": "number", "label": "Focal X", "min": 1, "step": 0.1, "default": 1200, "span": "quarter"},
        {"id": "focal_y", "type": "number", "label": "Focal Y", "min": 1, "step": 0.1, "default": 1200, "span": "quarter"},
        {"id": "principal_x", "type": "number", "label": "Principal X", "min": 0, "step": 0.1, "default": 512, "span": "quarter"},
        {"id": "principal_y", "type": "number", "label": "Principal Y", "min": 0, "step": 0.1, "default": 512, "span": "quarter"}
      ],
      "advanced": []
    },
    {
      "id": "inspect_glb",
      "group": "inspect",
      "title": "Inspect a GLB scene",
      "short": "Open an existing Fire3D or TRELLIS scene in the dependency-free native viewer.",
      "description": "Orbit, pan, zoom, inspect hierarchy, framing, bounds, triangle counts, materials, and animation clips without loading a model or contacting a renderer.",
      "icon": "◎",
      "badge": "INSTANT",
      "engine": "mm-tools native WebGL 2 viewer",
      "input_label": "GLB / glTF",
      "output_label": "Persistent scene library entry",
      "fields": [
        {"id": "glb_asset", "type": "asset", "label": "3D scene", "required": true, "span": "full", "accept": ".glb,.gltf", "icon": "◎", "drop_label": "Drop a Fire3D world or object"}
      ],
      "advanced": []
    }
  ]
}
