+def _numeric_video_sort_key(path):
+    """Sort `<prompt>-<sample>.mp4` by prompt and numeric sample index."""
+    name = str(path).rsplit('/', 1)[-1]
+    stem = name.rsplit('.', 1)[0]
+    prompt, separator, sample = stem.rpartition('-')
+    if not separator or not sample.isdigit():
+        raise ValueError(f"video filename has no numeric sample suffix: {path}")
+    return prompt, int(sample)
+
