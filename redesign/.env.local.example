# ReDesign's browser workbench constructs one QwenImageLayeredPipeline directly
# from these local components. It never contacts vLLM, ComfyUI, or an
# OpenAI-compatible controller. Group offload is the safe and responsive
# default when another model server already occupies the GPU.
REDESIGN_DIFFUSERS_TRANSFORMER=${HOME}/multimedia/models/qwen/T5B--qwen-image-layered-fp8/qwen_image_layered_fp8_e4m3fn.safetensors
REDESIGN_DIFFUSERS_COMPONENTS=${HOME}/multimedia/models/qwen/diffusers--hfstaff--Qwen-Image-Layered-modular
REDESIGN_DIFFUSERS_TEXT_ENCODER=${HOME}/multimedia/models/qwen/suzukimain--extraint4stuff--Qwen-Image-Layered-Control-SDNQ-int4/text_encoder
REDESIGN_DIFFUSERS_DTYPE=bfloat16
REDESIGN_DIFFUSERS_OFFLOAD=group
REDESIGN_GROUP_OFFLOAD_BLOCKS=1
REDESIGN_GROUP_OFFLOAD_STREAM=1

PYTHON_VERSION=3.12
UV_TORCH_BACKEND=cu130
REDESIGN_HOST=0.0.0.0
REDESIGN_PORT=8173
REDESIGN_MAX_UPLOAD_MB=80

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_CACHE=${HOME}/multimedia/redesign/weights
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
TOKENIZERS_PARALLELISM=false
GRADIO_ANALYTICS_ENABLED=false
