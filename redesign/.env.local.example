# Private OpenAI-compatible multimodal controller (local or private LAN only).
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=local-vllm
VLM_MODEL=compute1/Agents-A1-GPTQ-INT4-Sym

# Primary backend: native Diffusers with the downloaded mixed FP8/BF16
# transformer. We stream it without a second full checkpoint copy in RAM.
REDESIGN_QWEN_BACKEND=native-fp8
REDESIGN_QWEN_MODEL=${HOME}/multimedia/models/qwen/T5B--qwen-image-layered-fp8/qwen_image_layered_fp8_e4m3fn.safetensors
REDESIGN_QWEN_COMPONENTS=${HOME}/multimedia/models/qwen/diffusers--hfstaff--Qwen-Image-Layered-modular
REDESIGN_QWEN_TEXT_ENCODER_COMPONENTS=${HOME}/multimedia/models/qwen/suzukimain--extraint4stuff--Qwen-Image-Layered-Control-SDNQ-int4/text_encoder
REDESIGN_QWEN_DTYPE=bfloat16
REDESIGN_NATIVE_OFFLOAD=model

# Optional compatibility backend: an existing Windows Portable ComfyUI.
REDESIGN_COMFY_URL=http://127.0.0.1:8188
REDESIGN_QWEN_DIFFUSION=qwen_image_layered_int8convrot.safetensors
REDESIGN_QWEN_TEXT_ENCODER=qwen_2.5_vl_7b_fp8_scaled.safetensors
REDESIGN_QWEN_VAE=qwen_image_layered_vae.safetensors
REDESIGN_QWEN_INT8_PATH=${HOME}/multimedia/models/qwen/appmana--diffusion--qwen-image-layered-int8convrot/qwen_image_layered_int8convrot.safetensors
REDESIGN_QWEN_TEXT_ENCODER_PATH=${HOME}/multimedia/models/qwen/comfy-org--text--qwen_2.5_vl_7b_fp8_scaled.safetensors/split_files/text_encoders/qwen_2.5_vl_7b_fp8_scaled.safetensors
REDESIGN_QWEN_VAE_PATH=${HOME}/multimedia/models/qwen/comfy-org--vae--qwen_image_layered_vae.safetensors/split_files/vae/qwen_image_layered_vae.safetensors
REDESIGN_COMFY_TIMEOUT_SECONDS=3600

# This workstation has 32 GiB physical VRAM. The native profile moves complete
# modules between CPU and GPU; this switch applies only to legacy Diffusers.
REDESIGN_ALLOW_CPU_OFFLOAD=0
REDESIGN_GPU_HEADROOM_GIB=3
REDESIGN_CPU_HEADROOM_GIB=8

PYTHON_VERSION=3.12
UV_TORCH_BACKEND=cu130
REDESIGN_HOST=0.0.0.0
REDESIGN_PORT=8173
REDESIGN_MAX_UPLOAD_MB=80

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_CACHE=${HOME}/multimedia/redesign/weights
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
TOKENIZERS_PARALLELISM=false
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
GRADIO_ANALYTICS_ENABLED=false
