{
  "id": "wan-animate-2",
  "title": "Animate 2 Motion Studio",
  "short_name": "AN",
  "kind": "MOTION TRANSFER",
  "port": 8264,
  "kicker": "REFERENCE CHARACTER · DIRECT VIDEO MOTION · LOCAL GPU",
  "hero": "Direct the performance. Keep the character.",
  "description": "Transfer facial animation, body motion, and hand gestures from any driving clip onto one reference character with the distilled native Wan Animate 2 graph. Inspect the exact ViTPose skeleton and face track in a separate diagnostic lab when a difficult shot needs it.",
  "guide": "Start with the Portrait proof preset, a clean full-body reference, and a driving video of similar framing. Animate 2 consumes the real video directly—the pose lab is an optional inspection and retargeting surface, not a hidden prerequisite.",
  "engine": "Wan Animate 2 Distilled INT8 + Kijai ViTPose",
  "vram": "32 GiB GPU-only profile",
  "runtime_contract": "RTX 5090 · local Comfy graph · no CPU model offload",
  "residency": "Private per-job runtime",
  "default_mode": "motion_transfer",
  "max_upload_bytes": 25769803776,
  "theme": {"accent": "#9ae69a", "secondary": "#b58b67"},
  "badges": ["End-to-end motion", "Face + hands", "INT8 ConvRot", "Long-clip continuation", "ViTPose proof lab", "No telemetry"],
  "groups": [
    {"id": "create", "title": "Create"},
    {"id": "inspect", "title": "Inspect"}
  ],
  "models": [
    {"label": "Wan Animate 2 Distilled", "path": "../V2V/ComfyUI/models/diffusion_models/wan_animate_2_distill_int8_convrot.safetensors", "note": "INT8 ConvRot"},
    {"label": "UMT5 XXL", "path": "../V2V/ComfyUI/models/text_encoders/umt5_xxl_fp8_e4m3fn_scaled.safetensors", "note": "FP8 scaled"},
    {"label": "CLIP Vision H", "path": "../V2V/ComfyUI/models/clip_vision/clip_vision_h.safetensors"},
    {"label": "ViTPose + YOLO", "path": "../V2V/ComfyUI/models/detection/", "note": "Optional diagnostic lane"}
  ],
  "setup_steps": [
    "Run `cd ~/multimedia/animate && ./setupwithuv.sh` once. The command prepares the single shared V2V/Animate GPU environment.",
    "Run `./startwithuv.sh` and open the printed loopback URL.",
    "Use Motion transfer for normal work. Use Pose & face lab only to inspect detection, retarget a skeleton, or diagnose unusual framing."
  ],
  "presets": [
    {"title": "Portrait proof", "mode": "motion_transfer", "controls": {"width": 480, "height": 832, "length": 81, "fps": 24, "steps": 10, "pose_strength": 1, "reference_strength": 1, "cache_precision": "int8", "enable_context": false}},
    {"title": "Landscape performance", "mode": "motion_transfer", "controls": {"width": 832, "height": 480, "length": 81, "fps": 24, "steps": 10, "pose_strength": 1, "reference_strength": 1, "cache_precision": "int8", "enable_context": false}},
    {"title": "Long portrait continuity", "mode": "motion_transfer", "controls": {"width": 480, "height": 832, "length": 161, "fps": 24, "steps": 10, "cache_precision": "int4", "enable_context": true, "context_length": 21, "context_overlap": 8, "freenoise": true}},
    {"title": "Loose restyle", "mode": "motion_transfer", "controls": {"width": 480, "height": 832, "length": 81, "reference_strength": 0.72, "pose_strength": 0.9, "pose_end_percent": 0.78, "steps": 12}},
    {"title": "Pose audit", "mode": "pose_lab", "controls": {"width": 480, "height": 832, "face_padding": 24, "retarget_padding": 64, "body_stick_width": -1, "hand_stick_width": -1, "draw_head": true}}
  ],
  "modes": [
    {
      "id": "motion_transfer",
      "group": "create",
      "title": "Character motion transfer",
      "short": "Drive one character with the face, body, and hands from a real clip.",
      "description": "The native Comfy-Org distilled graph: direct video conditioning, independent identity and choreography weights, optional continuation, temporal context windows, GPU activation cache, exact scheduler controls, and production video encoding.",
      "icon": "✣",
      "badge": "WAN ANIMATE 2",
      "engine": "Wan Animate 2 Distilled",
      "input_label": "Character portrait + driving video",
      "output_label": "Motion-transferred video + run settings",
      "recipe": "The reference establishes appearance; the driving clip supplies facial animation, gesture, and body motion. Pose influence can be scheduled across denoising while reference strength remains global.",
      "fields": [
        {"type": "section", "label": "Cast & performance"},
        {"id": "reference_image_asset", "type": "asset", "label": "Reference character", "required": true, "span": "half", "accept": "image/*", "icon": "◎", "drop_label": "Drop a clean character image", "hint": "Full person and unobstructed hands give the motion branch the most room."},
        {"id": "driving_video_asset", "type": "asset", "label": "Driving performance", "required": true, "span": "half", "accept": "video/*", "icon": "▶", "drop_label": "Drop the motion clip", "hint": "The model reads the clip directly; no skeleton render is required."},
        {"id": "prompt", "type": "textarea", "label": "Character and scene direction", "default": "cinematic natural motion, stable identity, detailed face and hands", "rows": 4, "span": "full"},
        {"id": "pose_prompt", "type": "textarea", "label": "Motion-only direction", "default": "natural body motion, expressive face, coherent hand gestures", "rows": 3, "span": "full", "hint": "Describes movement rather than appearance."},
        {"type": "section", "label": "Frame & timeline"},
        {"id": "width", "type": "number", "label": "Width", "min": 256, "max": 1280, "step": 16, "default": 480, "suffix": " px", "span": "third"},
        {"id": "height", "type": "number", "label": "Height", "min": 256, "max": 1280, "step": 16, "default": 832, "suffix": " px", "span": "third"},
        {"id": "length", "type": "number", "label": "Frames (4n+1)", "min": 17, "max": 241, "step": 4, "default": 81, "span": "third"},
        {"id": "fps", "type": "range", "label": "Output FPS", "min": 1, "max": 60, "step": 1, "default": 24, "span": "half"},
        {"id": "video_frame_offset", "type": "number", "label": "Driving frame offset", "min": 0, "max": 99999, "step": 1, "default": 0, "span": "half"},
        {"id": "continue_motion_asset", "type": "asset", "label": "Previous generated clip · optional", "required": false, "span": "full", "accept": "video/*", "icon": "↝", "drop_label": "Continue from an earlier motion clip", "hint": "Carries the terminal motion frame into the next segment and adjusts the offset."},
        {"type": "section", "label": "Identity & choreography"},
        {"id": "reference_strength", "type": "range", "label": "Reference identity", "min": 0, "max": 2, "step": 0.01, "default": 1, "span": "half", "hint": "Lower permits restyling; higher resists visual drift."},
        {"id": "pose_strength", "type": "range", "label": "Motion adherence", "min": 0, "max": 2, "step": 0.01, "default": 1, "span": "half"},
        {"id": "pose_start_percent", "type": "range", "label": "Pose starts", "min": 0, "max": 1, "step": 0.01, "default": 0, "span": "half"},
        {"id": "pose_end_percent", "type": "range", "label": "Pose ends", "min": 0, "max": 1, "step": 0.01, "default": 1, "span": "half", "hint": "Ending earlier loosens fine detail while preserving early choreography."},
        {"id": "seed", "type": "number", "label": "Seed", "min": 0, "max": 1125899906842624, "step": 1, "default": 42, "span": "half"},
        {"id": "trim_duplicate", "type": "toggle", "label": "Continuation cleanup", "default": false, "span": "half", "toggle_label": "Trim the duplicated first decoded frame"}
      ],
      "advanced": [
        {"type": "section", "label": "Distilled sampler"},
        {"id": "steps", "type": "range", "label": "Sampling steps", "min": 4, "max": 30, "step": 1, "default": 10, "span": "half"},
        {"id": "guidance", "type": "range", "label": "CFG", "min": 0, "max": 5, "step": 0.05, "default": 1, "span": "half"},
        {"id": "sampler", "type": "select", "label": "Sampler", "default": "lcm", "span": "third", "options": [{"value": "lcm", "label": "LCM · distilled native"}, {"value": "euler", "label": "Euler"}, {"value": "dpmpp_2m", "label": "DPM++ 2M"}]},
        {"id": "scheduler", "type": "select", "label": "Scheduler", "default": "simple", "span": "third", "options": [{"value": "simple", "label": "Simple"}, {"value": "sgm_uniform", "label": "SGM uniform"}, {"value": "normal", "label": "Normal"}]},
        {"id": "shift", "type": "number", "label": "Model shift", "min": 0, "max": 20, "step": 0.1, "default": 5, "span": "third"},
        {"id": "denoise", "type": "range", "label": "Denoise", "min": 0.1, "max": 1, "step": 0.01, "default": 1, "span": "half"},
        {"id": "add_noise", "type": "toggle", "label": "Noise", "default": true, "span": "half", "toggle_label": "Initialize with seeded noise"},
        {"id": "negative_prompt", "type": "textarea", "label": "Negative prompt", "default": "oversaturated, overexposed, static, blurred details, subtitles, painting, still frame, gray cast, worst quality, low quality, jpeg artifacts, ugly, malformed limbs, fused fingers, bad hands, bad face, frozen motion, cluttered background, duplicate limbs, backwards walking", "rows": 4, "span": "full"},
        {"type": "section", "label": "Long clip & GPU cache"},
        {"id": "enable_context", "type": "toggle", "label": "Temporal context", "default": false, "span": "half", "toggle_label": "Sample in overlapping temporal windows"},
        {"id": "cache_precision", "type": "choice", "label": "GPU pose cache", "default": "int8", "span": "full", "options": [{"value": "disabled", "label": "Disabled", "description": "Minimum VRAM; pose branch repeats each step."}, {"value": "int8", "label": "INT8", "description": "Native 5090 balance; roughly halves pose work."}, {"value": "int4", "label": "INT4", "description": "Smallest GPU cache for longer windows."}]},
        {"id": "context_length", "type": "number", "label": "Latent window", "min": 5, "max": 81, "step": 1, "default": 21, "span": "third"},
        {"id": "context_overlap", "type": "number", "label": "Window overlap", "min": 0, "max": 80, "step": 1, "default": 8, "span": "third"},
        {"id": "context_stride", "type": "number", "label": "Window stride", "min": 1, "max": 16, "step": 1, "default": 1, "span": "third"},
        {"id": "context_schedule", "type": "select", "label": "Window schedule", "default": "standard_static", "span": "half", "options": [{"value": "standard_static", "label": "Static · cache compatible"}, {"value": "standard_uniform", "label": "Uniform"}, {"value": "looped_uniform", "label": "Uniform looped"}, {"value": "batched", "label": "Batched"}]},
        {"id": "fuse_method", "type": "select", "label": "Window fusion", "default": "pyramid", "span": "half", "options": [{"value": "pyramid", "label": "Pyramid"}, {"value": "relative", "label": "Relative"}, {"value": "flat", "label": "Flat"}, {"value": "overlap_linear", "label": "Linear overlap"}]},
        {"id": "freenoise", "type": "toggle", "label": "FreeNoise", "default": true, "span": "half", "toggle_label": "Shuffle noise for smoother window blends"},
        {"id": "closed_loop", "type": "toggle", "label": "Loop context", "default": false, "span": "half", "toggle_label": "Close the temporal window loop"},
        {"type": "section", "label": "Framing & delivery"},
        {"id": "crop", "type": "select", "label": "Resize crop", "default": "center", "span": "half", "options": [{"value": "center", "label": "Center crop"}, {"value": "disabled", "label": "No crop"}]},
        {"id": "scale_method", "type": "select", "label": "Resize filter", "default": "area", "span": "half", "options": [{"value": "area", "label": "Area"}, {"value": "lanczos", "label": "Lanczos"}, {"value": "bicubic", "label": "Bicubic"}, {"value": "bilinear", "label": "Bilinear"}]},
        {"id": "container", "type": "select", "label": "Container", "default": "mp4", "span": "third", "options": [{"value": "mp4", "label": "MP4"}, {"value": "mkv", "label": "MKV"}, {"value": "webm", "label": "WebM"}]},
        {"id": "codec", "type": "select", "label": "Codec", "default": "h264", "span": "third", "options": [{"value": "h264", "label": "H.264"}, {"value": "av1", "label": "AV1"}, {"value": "auto", "label": "Auto"}]},
        {"id": "crf", "type": "range", "label": "Delivery CRF", "min": 0, "max": 51, "step": 1, "default": 18, "span": "third"},
        {"id": "bit_depth", "type": "select", "label": "Bit depth", "default": 8, "span": "half", "options": [{"value": 8, "label": "8-bit"}, {"value": 10, "label": "10-bit"}]},
        {"id": "color_space", "type": "select", "label": "Color space", "default": "sRGB", "span": "half", "options": [{"value": "sRGB", "label": "sRGB"}, {"value": "HDR", "label": "BT.2020 HLG"}, {"value": "HDR PQ", "label": "BT.2020 PQ"}]}
      ],
      "preview_template": "{{width}}×{{height}} · {{length}} frames @ {{fps}} FPS · identity {{reference_strength}} · motion {{pose_strength}}"
    },
    {
      "id": "pose_lab",
      "group": "inspect",
      "title": "Pose & face diagnostic lab",
      "short": "Render the full-body, hand, head, and face tracking proof before a difficult animation.",
      "description": "Runs the pinned Kijai CUDA ONNX preprocessor and exports a retargeted ViTPose movie, synchronized 512px face crops, and key-body-point JSON. It is a diagnostic/creative utility; normal Animate 2 generation remains end-to-end.",
      "icon": "⌁",
      "badge": "VITPOSE + YOLO",
      "engine": "ViTPose H WholeBody / YOLOv10m",
      "input_label": "Driving clip + optional character reference",
      "output_label": "Pose proof + face track + points",
      "recipe": "Add a retarget image to align proportions to the destination character. Stick widths of -1 are automatic; zero disables that body region.",
      "fields": [
        {"id": "driving_video_asset", "type": "asset", "label": "Driving video", "required": true, "span": "full", "accept": "video/*", "icon": "▶", "drop_label": "Drop a performance to inspect"},
        {"id": "retarget_image_asset", "type": "asset", "label": "Retarget reference · optional", "required": false, "span": "full", "accept": "image/*", "icon": "◎", "drop_label": "Align the skeleton to another character"},
        {"id": "width", "type": "number", "label": "Canvas width", "min": 256, "max": 1280, "step": 16, "default": 480, "span": "half"},
        {"id": "height", "type": "number", "label": "Canvas height", "min": 256, "max": 1280, "step": 16, "default": 832, "span": "half"},
        {"id": "face_padding", "type": "range", "label": "Face crop padding", "min": 0, "max": 256, "step": 1, "default": 24, "suffix": " px", "span": "half"},
        {"id": "retarget_padding", "type": "range", "label": "Retarget framing padding", "min": 0, "max": 256, "step": 1, "default": 64, "suffix": " px", "span": "half"},
        {"id": "body_stick_width", "type": "range", "label": "Body line width", "min": -1, "max": 20, "step": 1, "default": -1, "span": "half"},
        {"id": "hand_stick_width", "type": "range", "label": "Hand line width", "min": -1, "max": 20, "step": 1, "default": -1, "span": "half"},
        {"id": "draw_head", "type": "toggle", "label": "Head points", "default": true, "span": "half", "toggle_label": "Draw head and facial keypoints"},
        {"id": "crf", "type": "range", "label": "Proof CRF", "min": 0, "max": 51, "step": 1, "default": 18, "span": "half"}
      ],
      "advanced": [],
      "preview_template": "CUDA whole-body tracking at {{width}}×{{height}} · face padding {{face_padding}} px"
    }
  ]
}
