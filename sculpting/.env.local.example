# Loopback is the safe default. When deliberately exposing this studio to the
# private LAN, set SCULPT_STUDIO_HOST=0.0.0.0 and a long MM_STUDIO_TOKEN.
SCULPT_STUDIO_HOST=127.0.0.1
SCULPT_STUDIO_PORT=8262
MM_STUDIO_TOKEN=

# The canonical RTX 5090 path uses PyTorch's fused SDPA implementation. No
# FlashAttention/xFormers package is needed or loaded.
ATTN_BACKEND=sdpa
SPARSE_ATTN_BACKEND=sdpa
SPARSE_CONV_BACKEND=flex_gemm
