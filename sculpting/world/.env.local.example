# Loopback is private by default. For a deliberate private-LAN listener, use
# 0.0.0.0 and set a long MM_STUDIO_TOKEN.
WORLD_SCULPT_HOST=127.0.0.1
WORLD_SCULPT_PORT=8263
MM_STUDIO_TOKEN=

# Canonical RTX 5090 kernels. The WorldSculpt release has geometry weights only;
# there is no low-VRAM/CPU-offload or fabricated texture-checkpoint mode.
ATTN_BACKEND=sdpa
SPARSE_ATTN_BACKEND=sdpa
SPARSE_CONV_BACKEND=flex_gemm
