{
  "id": "sculpting",
  "title": "Sculpting Studio",
  "short_name": "Sculpt",
  "kind": "PBR 3D ASSET STUDIO",
  "port": 8262,
  "kicker": "RECONSTRUCT · CAMERA MATCH · RETEXTURE · DELIVER",
  "hero": "One reference in. A production-ready object out.",
  "description": "A private TRELLIS.2 and Pixal3D workstation with complete sparse-shape, camera, PBR, UV, remesh, preview, and export controls. Generated GLBs open in the built-in WebGL inspection room without a CDN or cloud viewer.",
  "guide": "Use TRELLIS.2 for general single-image assets. Use Pixal3D when camera perspective and scale fidelity matter. The verified RTX 5090 profile keeps every model on CUDA and defaults to 1024 cascade; 1536 is visibly documented but refused on 32 GiB rather than secretly offloading to CPU.",
  "engine": "TRELLIS.2-4B + Pixal3D + MoGe-2 + NAF",
  "vram": "24–31 GiB · 1024 cascade",
  "runtime_contract": "RTX 5090 · GPU-resident · one model stack at a time · no telemetry",
  "residency": "Explicit model switcher; no CPU model shuttling",
  "default_mode": "trellis_generate",
  "max_upload_bytes": 17179869184,
  "theme": {"accent": "#7de0ad", "secondary": "#b9916a"},
  "badges": ["Full PBR", "Camera-aware projection", "WebGL GLB room", "Shape-conditioned texturing", "Exact sampler controls", "Offline runtime"],
  "groups": [
    {"id": "create", "title": "Create"},
    {"id": "camera", "title": "Camera match"},
    {"id": "material", "title": "Materials"},
    {"id": "utility", "title": "Mesh utility"}
  ],
  "models": [
    {"label": "TRELLIS.2-4B", "path": "pretrained/TRELLIS.2-4B", "note": "512, 1024, cascade shape + full PBR volume"},
    {"label": "Pixal3D", "path": "world/pretrained/Pixal3D", "note": "View-aligned projected image conditioning"},
    {"label": "DINOv3 ViT-L/16", "path": "pretrained/deps/camenduru--dinov3-vitl16-pretrain-lvd1689m"},
    {"label": "BiRefNet", "path": "pretrained/deps/ZhengPeng7--BiRefNet", "note": "Official ungated local matte"},
    {"label": "MoGe-2 ViT-L", "path": "pretrained/deps/Ruicheng--moge-2-vitl", "note": "Automatic intrinsics and horizontal FOV"},
    {"label": "NAF", "path": "pretrained/deps/valeoai--NAF/naf_release.pth", "note": "Projection-feature upsampling"}
  ],
  "setup_steps": [
    "Run `cd ~/multimedia/sculpting && ./setupwithuv.sh` once. It pins and compiles the CUDA mesh stack for the installed 5090.",
    "Start with `./startwithuv.sh`; the listener remains `127.0.0.1:8262` unless explicitly changed in `.env.local`.",
    "For a first pass choose TRELLIS 1024 cascade, 12/12/12 steps, 2K textures, and a 300K delivery mesh.",
    "Open every GLB in the local WebGL output room: orbit, zoom, reset, wire inspection, auto-orbit, fullscreen, and A/B compare are built in.",
    "Use Camera match for a photographed product or object whose lens perspective must survive reconstruction; automatic MoGe is released before Pixal loads."
  ],
  "presets": [
    {"title": "5090 production PBR", "mode": "trellis_generate", "controls": {"pipeline_type": "1024_cascade", "ss_steps": 12, "shape_steps": 12, "texture_steps": 12, "max_num_tokens": 49152, "texture_size": 2048, "decimation_target": 300000, "render_turntable": true}},
    {"title": "Fast shape proof", "mode": "trellis_generate", "controls": {"pipeline_type": "512", "ss_steps": 8, "shape_steps": 8, "texture_steps": 8, "max_num_tokens": 24576, "texture_size": 1024, "decimation_target": 100000}},
    {"title": "Camera-faithful product", "mode": "pixal_generate", "controls": {"camera_mode": "auto", "pipeline_type": "1024_cascade", "max_num_tokens": 49152, "texture_size": 4096, "decimation_target": 500000}},
    {"title": "Game-ready delivery", "mode": "mesh_lab", "controls": {"merge_vertices": true, "remove_degenerate": true, "fix_normals": true, "center_origin": true, "face_target": 75000, "output_format": "glb"}}
  ],
