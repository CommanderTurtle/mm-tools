# Underbelly is local-only. Paths may use $HOME because integrate.sh sources
# this file in a non-privileged shell.
ANYDOC_INSTALL_LOCATION="$HOME/.bun/install/global/node_modules/@firecrawl/anydoc"
FIRECRAWL_CLI_INSTALL_LOCATION="$HOME/.bun/install/global/node_modules/firecrawl-cli"
FIRECRAWL_SERVICE_IS_DOCKER=true
FIRECRAWL_INSTALL_LOCATION="$HOME/Hermes/firecrawl/firecrawl"
NATIVE_LANGUAGE=en
TRANSLATE_HTTP_SERVICE_PORT=8176
