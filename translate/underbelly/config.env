# Underbelly is local-only. Paths may use $HOME because integrate.sh sources
# this file in a non-privileged shell.
# ANYDOC_INSTALL_LOCATION and FIRECRAWL_CLI_INSTALL_LOCATION are left empty on
# purpose: integrate.sh resolves the Bun global root in use (Sandwich's answer,
# otherwise bunfig's globalDir, the launchers on PATH, then the prefix
# defaults). Set either one only to point at a root that resolution misses.
ANYDOC_INSTALL_LOCATION=
FIRECRAWL_CLI_INSTALL_LOCATION=
FIRECRAWL_SERVICE_IS_DOCKER=true
FIRECRAWL_INSTALL_LOCATION="$HOME/Documents/Dev/firecrawl/firecrawl"
NATIVE_LANGUAGE=en
TRANSLATE_HTTP_SERVICE_PORT=8176
# Optional fallback when YouTube's transcript API cannot serve a caption track.
CAMOFOX_HTTP_SERVICE_PORT=9377
