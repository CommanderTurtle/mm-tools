# Already-running NInfer server. Start NInfer with --jev; no weights are loaded here.
JEV_BASE_URL=http://127.0.0.1:8000
# Empty selects the single model advertised by /v1/models.
JEV_MODEL=
JEV_API_KEY=

# Same translator port and bearer contract as the existing dedicated backend.
TRANSLATE_HOST=0.0.0.0
TRANSLATE_PORT=8176
TRANSLATE_API_KEY=

# On-demand work only. Keep below the caller's total request timeout (MV3: 120s).
JEV_TIMEOUT_SECONDS=110
JEV_CONCURRENCY=1
JEV_CHUNK_BYTES=1600
JEV_MAX_TOKENS=2048
TRANSLATE_MAX_BODY_BYTES=1048576
TRANSLATE_MAX_VISION_BODY_BYTES=33554432
