TRANSLATE_HOST=0.0.0.0
TRANSLATE_PORT=8176
TRANSLATE_UI_HOST=0.0.0.0
TRANSLATE_UI_PORT=8177
TRANSLATE_UI_AUTOLOAD=0
TRANSLATE_EXTERNAL_HOST=127.0.0.1
TRANSLATE_EXTERNAL_TIMEOUT=10
TRANSLATE_AUTOLOAD=1
TRANSLATE_MODEL_PATH=~/multimedia/models/text-only/mradermacher--EraX-Translator-V1.0-GGUF/EraX-Translator-V1.0.Q8_0.gguf
TRANSLATE_DETECTOR_PATH=~/multimedia/models/text-only/papluca--xlm-roberta-base-language-detection
TRANSLATE_ARBITER_MODEL_PATH=~/multimedia/models/text-only/anhbn--EraX-VL-7B-V1.5-Openvino-INT4
TRANSLATE_ARBITER_RUNTIME_PATH=~/multimedia/translate/.runtime/erax-vl-openvino
TRANSLATE_ARBITER_DEVICE=CPU
TRANSLATE_ARBITER_MAX_TOKENS=16
TRANSLATE_ARBITER_FINALISTS=4
TRANSLATE_VISION_MAX_TOKENS=512
TRANSLATE_VISION_EXTERNAL_TIMEOUT=180
# Keep the JSON-body limit comfortably above 4/3 of the decoded-file limit so
# Base64 plus the surrounding request object fits without changing text limits.
TRANSLATE_MAX_IMAGE_BYTES=20971520
TRANSLATE_MAX_IMAGE_PIXELS=50000000
TRANSLATE_MAX_TOKENS=512
TRANSLATE_CONTEXT=2048
TRANSLATE_GPU_LAYERS=-1
TRANSLATE_THREADS=8
TRANSLATE_MAX_BODY_BYTES=1048576
TRANSLATE_MAX_VISION_BODY_BYTES=33554432
# Optional LAN bearer token. Empty is appropriate only on a trusted private LAN.
TRANSLATE_API_KEY=

# Runtime is strictly local. Model resolution must never fall through to a
# hosted hub, and supporting libraries should emit no usage telemetry.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
SCARF_NO_ANALYTICS=1
TOKENIZERS_PARALLELISM=false
