TRANSLATE_HOST=0.0.0.0
TRANSLATE_PORT=8176
TRANSLATE_AUTOLOAD=1
TRANSLATE_MODEL_PATH=~/multimedia/models/text-only/anhbn--raX-Translator-V1.0-GGUF/EraX-Translator-V1.0.Q6_K.gguf
TRANSLATE_DETECTOR_PATH=~/multimedia/models/text-only/papluca--xlm-roberta-base-language-detection
TRANSLATE_ARBITER_MODEL_PATH=~/multimedia/models/text-only/anhbn--EraX-VL-7B-V1.5-Openvino-INT4
TRANSLATE_ARBITER_RUNTIME_PATH=~/multimedia/translate/.runtime/erax-vl-openvino
TRANSLATE_ARBITER_DEVICE=CPU
TRANSLATE_ARBITER_MAX_TOKENS=16
TRANSLATE_ARBITER_FINALISTS=4
TRANSLATE_MAX_TOKENS=512
TRANSLATE_CONTEXT=2048
TRANSLATE_GPU_LAYERS=-1
TRANSLATE_THREADS=8
TRANSLATE_MAX_BODY_BYTES=1048576
# Optional LAN bearer token. Empty is appropriate only on a trusted private LAN.
TRANSLATE_API_KEY=

# Runtime is strictly local. Model resolution must never fall through to a
# hosted hub, and supporting libraries should emit no usage telemetry.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
SCARF_NO_ANALYTICS=1
TOKENIZERS_PARALLELISM=false
