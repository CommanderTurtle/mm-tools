TRANSLATE_HOST=0.0.0.0
TRANSLATE_PORT=8176
TRANSLATE_AUTOLOAD=1
TRANSLATE_MODEL_PATH=~/multimedia/models/qwen/text-encoder-vl-nvfp4/qwen3_vl_4b_nvfp4_full.safetensors
TRANSLATE_COMFY_SOURCE=./.runtime/ComfyUI
TRANSLATE_MAX_TOKENS=256
TRANSLATE_MAX_BODY_BYTES=1048576
# Optional LAN bearer token. Empty is appropriate only on a trusted private LAN.
TRANSLATE_API_KEY=

# Runtime is strictly local. Model resolution must never fall through to a
# hosted hub, and supporting libraries should emit no usage telemetry.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
TOKENIZERS_PARALLELISM=false
